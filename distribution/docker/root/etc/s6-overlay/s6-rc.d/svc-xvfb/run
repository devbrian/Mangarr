#!/command/with-contenv bash
# Sonarr divergence: Mangarr-only s6 service; no Sonarr peer (Sonarr ships no headless-browser
# dependency). Phase 33.3 — comix.to's Cloudflare MANAGED challenge does NOT auto-solve for a
# HEADLESS browser (headless Chromium reports window.outerWidth=0, which the challenge reads as a
# bot tell — empirically: 45s "Just a moment" stall headless vs ~3s cold-solve headed). The Comix
# runtime signer (ComixPlaywrightSigner) therefore launches Chromium HEADED; on a display-less server
# that requires a virtual X display, provided here as :99. See
# .planning/phases/33.3-comix-signer-managed-challenge-bypass/ (PROVEN on this Docker target).
#
# Xvfb runs in the foreground (no -daemon) so s6-supervise manages it as a longrun. 1920x1080x24
# matches the signer's --window-size=1920,1080 and a realistic screen fingerprint. -nolisten tcp =
# no TCP X listener (unix socket only); -ac disables host-based access control so the abc-user
# Chromium (svc-mangarr runs as abc; Xvfb runs as root) can connect to the root-owned display.
# DISPLAY=:99 is set image-wide via the Dockerfile ENV so the svc-mangarr process + its Chromium
# child inherit it.
exec Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp -ac
