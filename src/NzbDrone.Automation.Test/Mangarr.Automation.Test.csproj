<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.59.0" />
    <!-- NOTE (issue #133, RESOLVED): Microsoft.Playwright 1.59.0 is a netstandard2.0 library that pulls
         the Microsoft.Bcl.AsyncInterfaces polyfill; on .NET 10 a netstandard2.0 polyfill DLL deployed
         into the shared _tests/ output dir shadows the in-box IAsyncDisposable and makes Playwright's
         IBrowser/IBrowserContext DisposeAsync() throw EntryPointNotFoundException. The polyfill was NOT
         coming from Playwright's package graph — it was coverlet.collector 6.0.4 unconditionally copying
         its bundled build/netstandard2.0/Microsoft.Bcl.AsyncInterfaces.dll into $(PublishDir). The proper
         fix lives in src/Directory.Build.props: an explicit Microsoft.Bcl.AsyncInterfaces 10.0.7 ref in
         the shared TestProject ItemGroup puts the harmless netstandard2.1 type-forwarder into every test
         project's ResolvedFileToPublish, so coverlet's own dedup strips its bundled polyfill. A per-csproj
         ref here would NOT fix it (all 11 test projects share one _tests/ dir — md5-identical evidence). -->
    <!-- Plan 19-01 Open Question 1 verdict = raw-SQLite seed helpers. Version
         matched to the backend's canonical SQLite ADO pin in
         NzbDrone.Common/Mangarr.Common.csproj (System.Data.SQLite 2.0.3) so the
         TestKit.Seed{HistoryFailed,Blocklist,PendingQueueItem}Async helpers open
         <AppData>/mangarr.db with the same provider the backend itself uses. -->
    <PackageReference Include="System.Data.SQLite" Version="2.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NzbDrone.Test.Common\Mangarr.Test.Common.csproj" />
  </ItemGroup>
</Project>
