# Auto detect text files and perform LF normalization
* text=auto

# Explicitly set bash scripts to have unix endings
# when checked out on windows
*.sh text eol=lf
distribution/debian/* text eol=lf
distribution/osx/Sonarr text eol=lf
# s6-overlay service tree — extensionless files (type/up/run) + scripts are read
# by s6-rc-compile, which rejects CRLF ("invalid .../type: must be oneshot,
# longrun, or bundle"). Without forcing LF a Windows checkout corrupts them and
# the runtime image fails to boot. Keep this BELOW `* text=auto` so it wins.
distribution/docker/root/** text eol=lf

# Custom for Visual Studio
*.cs     diff=csharp
*.sln    merge=union

# Reference Preservation Policy (Phase 15 D-26): exclude preserved Sonarr vertical slices
# from GitHub language statistics — these files are read-only reference for v1.x/v2 translation,
# not part of the active Mangarr codebase.
.planning/reference/** linguist-detectable=false
