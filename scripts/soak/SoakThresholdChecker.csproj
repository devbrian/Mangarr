<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Mangarr.Soak</RootNamespace>
    <AssemblyName>Mangarr.Soak.ThresholdChecker</AssemblyName>
    <!-- See .planning/debug/ci-soak-two-main-entry.md — disambiguates the entry point
         when SoakRunner.cs + SoakThresholdChecker.cs co-locate in the same project dir. -->
    <StartupObject>Mangarr.Soak.SoakThresholdChecker</StartupObject>
  </PropertyGroup>
</Project>
