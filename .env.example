# .env.example — copy to .env and adjust for your host, then:
#   docker compose build && docker compose up -d
# Consumed by docker-compose.yml (the local Mangarr test-harness).

# Image tag + build args
MANGARR_VERSION=local
TARGETARCH=amd64

# Host port -> container 8989. Pick a free port if 8989 is taken on the host
# (e.g. an existing Sonarr).
MANGARR_PORT=8990

# Run-as user/group + umask + timezone (hotio-style s6 env).
# IMPORTANT: set PUID/PGID to the SAME uid/gid the manga-gateway container writes
# its CBZs as, so Mangarr can read AND delete them from the download dir during
# import (the gateway writes 600 files / 755 dirs owned by that uid). Classic
# *arr stack uid alignment — a mismatch causes "UnauthorizedAccessException ...
# is denied" on import. Example assumes the gateway runs as 10001.
PUID=10001
PGID=10001
UMASK=002
TZ=Etc/UTC

# Host paths:
#   config  : Mangarr config.xml + mangarr.db + logs            -> /config
#   dl      : gateway CBZ landing zone (== gateway's /data/manga) -> /data/manga
#             (mounted at the SAME path the gateway reports, so import needs no
#              Remote Path Mapping)
#   library : Mangarr root folder (imports move here)            -> /data/media
MANGARR_CONFIG_DIR=/opt/mangarr
MANGARR_DL_DIR=/mnt/mediatrial/mangarr_dl
MANGARR_LIBRARY_DIR=/mnt/mediatrial/Manga
